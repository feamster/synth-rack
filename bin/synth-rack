#!/bin/bash
# Launch the app from anywhere. Link this file onto your PATH:
#   ln -sf "$(pwd)/bin/synth-rack" ~/.local/bin/synth-rack
# It runs from the repository it lives in and builds the virtualenv on first use.
set -e
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do                       # follow the PATH symlink back to the repo
    target="$(readlink "$src")"
    case "$target" in /*) src="$target" ;; *) src="$(dirname "$src")/$target" ;; esac
done
root="$(cd "$(dirname "$src")/.." && pwd)"
py="$root/.venv/bin/python"
if [ ! -x "$py" ]; then
    echo "First run: setting up $root/.venv ..." >&2
    if command -v uv >/dev/null; then
        uv venv --python 3.12 "$root/.venv" -q && uv pip install -q --python "$py" -r "$root/requirements.txt"
    else
        python3 -m venv "$root/.venv" && "$py" -m pip install -q -r "$root/requirements.txt"
    fi
fi
# The window opens and the prompt comes straight back. `--fg` keeps it attached to the
# terminal instead (so do --help and --screenshot, which print and exit).
fg=0; args=()
for a in "$@"; do
    case "$a" in
        --fg) fg=1 ;;
        -h|--help|--screenshot|--screenshot=*) fg=1; args+=("$a") ;;
        *) args+=("$a") ;;
    esac
done
[ "$fg" = 1 ] && exec "$py" "$root/src/main.py" "${args[@]}"

log="$HOME/.synth-rack/last-run.log"
mkdir -p "$(dirname "$log")"
nohup "$py" "$root/src/main.py" "${args[@]}" >"$log" 2>&1 </dev/null &
pid=$!
sleep 1
if ! kill -0 "$pid" 2>/dev/null; then          # died straight away: show why
    cat "$log" >&2
    exit 1
fi
echo "synth-rack is running (output in ${log/#$HOME/~}; \`synth-rack --fg\` keeps it in the terminal)"
